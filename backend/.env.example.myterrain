APP_NAME=myTerrain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myterrain
DB_USERNAME=root
DB_PASSWORD=

# Sanctum
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:3000,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=myterrain_

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@myterrain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase (Phase 8)
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Paiement (Phase 8)
WAVE_API_KEY=
ORANGE_MONEY_MERCHANT_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

VITE_APP_NAME="${APP_NAME}"
